<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Intentional design decisions, with justification. Keep this list short. -->

    <!-- False positive: the record's compact constructor deep-copies every component via
         List.copyOf + Map.copyOf + Set.copyOf, so these accessors return JDK-immutable
         collections. SpotBugs reasons over the declared Map/Set interface types and cannot see
         this. Scoped to the accessors so any future exposure elsewhere in AclPolicy still fails
         the build. -->
    <Match>
        <Class name="com.automattic.kyuubi.spark.localfileacl.AclPolicy"/>
        <Or>
            <Method name="userRules"/>
            <Method name="groupRules"/>
            <Method name="unresolvedPaths"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
